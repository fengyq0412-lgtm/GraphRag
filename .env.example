# Copy to .env in the project root and fill in your model credentials.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
# Slow model responses can require a longer read timeout (5-600 seconds).
LLM_TIMEOUT=180
# Only set this if your OpenAI-compatible provider supports enable_thinking.
# LLM_ENABLE_THINKING=false
# GRAPHRAG_DB=data/graphrag.sqlite
